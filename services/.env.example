# Settings of services/ - copy the lines you change into .env (git-ignored; the tasks
# also read the forge .env). Generated by `task services:env` from the compose files,
# defaults shown. Change every password before exposing anything.

# shared
# repository root: volumes bind ${REPO_DIR}/datasets/_dockdrives/<volume> (tasks set it)
REPO_DIR=
# main domain: routes <name>.DOMAIN, the wildcard certificate, the LDAP base
DOMAIN=gr.rs-tech.online
# interface of the few published ports (traefik); 0.0.0.0 opens them to the network
BIND=127.0.0.1
TZ=Etc/UTC

# databases/mariadb
MARIADB_ROOT_PASSWORD=gitrecon-root
MARIADB_DATABASE=paymenter
MARIADB_USER=paymenter
MARIADB_PASSWORD=gitrecon

# databases/postgres
POSTGRES_USER=gitrecon
POSTGRES_PASSWORD=gitrecon
POSTGRES_DB=gitrecon
POSTGRES_MULTIPLE_DATABASES=gitea,wikijs,n8n,metamcp

# internals/gitea
GITEA_SSH_PORT=2222

# internals/searxng
SEARXNG_SECRET=change-me-searxng-secret

# automations/metamcp
METAMCP_AUTH_SECRET=change-me-metamcp-secret

# automations/n8n
N8N_ENCRYPTION_KEY=change-me-n8n-key
N8N_SECURE_COOKIE=false

# automations/openclaw
OPENCLAW_USERNAME=admin
OPENCLAW_PASSWORD=
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_OLLAMA_URL=http://ollama:11434
XAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# automations/transmission
TRANSMISSION_PEER_BIND=0.0.0.0

# automations/typesense
TYPESENSE_API_KEY=change-me-typesense

# networking/cloudflared
CLOUDFLARE_TUNNEL_TOKEN=

# networking/dnsmasq
DNS_UPSTREAM_1=1.1.1.1
DNS_UPSTREAM_2=9.9.9.9

# networking/ngrok
NGROK_AUTHTOKEN=

# networking/openldap
LDAP_ORGANISATION=RedScope Technologies
LDAP_ADMIN_PASSWORD=change-me-ldap

# networking/traefik
CF_DNS_API_TOKEN=
TRAEFIK_BIND=127.0.0.1
TRAEFIK_HTTP_PORT=8880
TRAEFIK_HTTPS_PORT=8843

# networking/wireguard
WIREGUARD_SERVER_URL=auto
WIREGUARD_PORT=51820
WIREGUARD_PEERS=1
WIREGUARD_BIND=0.0.0.0

# runners/gitea-runner
GITEA_RUNNER_INSTANCE_URL=http://gitea:3000
GITEA_RUNNER_TOKEN=
GITEA_RUNNER_NAME=gitrecon

# runners/github-runner
GITHUB_RUNNER_REPOSITORY=Sarverott/gitrecon
GITHUB_RUNNER_TOKEN=
GITHUB_RUNNER_LABELS=gitrecon
GITHUB_RUNNER_PREFIX=gitrecon
GITHUB_RUNNERS=1
