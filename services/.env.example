# Settings of services/<group>/*.compose.yaml - copy the lines you change into .env
# (git-ignored; the docker:* and services:* tasks also read the forge .env).
# Generated from the compose files; defaults shown. Change every password before exposing anything.

# shared
# repository root: volumes bind ${REPO_DIR}/datasets/_dockdrives/<volume> (tasks set it)
REPO_DIR=
# interface for published ports; 0.0.0.0 makes them reachable from outside
BIND=127.0.0.1
TZ=Etc/UTC

# databases/chromadb
CHROMADB_PORT=8000

# databases/mariadb
MARIADB_ROOT_PASSWORD=gitrecon-root
MARIADB_DATABASE=paymenter
MARIADB_USER=paymenter
MARIADB_PASSWORD=gitrecon
MARIADB_PORT=3306

# databases/postgres
POSTGRES_USER=gitrecon
POSTGRES_PASSWORD=gitrecon
POSTGRES_DB=gitrecon
POSTGRES_MULTIPLE_DATABASES=gitea,wikijs,n8n,metamcp
POSTGRES_PORT=5432

# databases/redis
REDIS_PORT=6379

# internals/firefox
FIREFOX_PORT=5800

# internals/gitea
GITEA_ROOT_URL=http://localhost:3000/
GITEA_SSH_PORT=2222
GITEA_PORT=3000

# internals/ollama
OLLAMA_PORT=11435

# internals/registry
REGISTRY_PORT=5000

# internals/searxng
SEARXNG_BASE_URL=http://localhost:8888/
SEARXNG_SECRET=change-me-searxng-secret
SEARXNG_PORT=8888

# internals/wikijs
WIKIJS_PORT=3001

# automations/home-assistant
HOME_ASSISTANT_PORT=8123

# automations/metamcp
METAMCP_URL=http://localhost:12008
METAMCP_AUTH_SECRET=change-me-metamcp-secret
METAMCP_PORT=12008

# automations/n8n
N8N_ENCRYPTION_KEY=change-me-n8n-key
N8N_SECURE_COOKIE=false
N8N_PORT=5678

# automations/ntfy
NTFY_BASE_URL=http://localhost:8090
NTFY_PORT=8090

# automations/openclaw
OPENCLAW_USERNAME=admin
OPENCLAW_PASSWORD=
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_OLLAMA_URL=http://ollama:11434
XAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENCLAW_PORT=18080

# automations/paymenter
PAYMENTER_PORT=8085

# automations/transmission
TRANSMISSION_PORT=9091
TRANSMISSION_PEER_BIND=0.0.0.0

# automations/typesense
TYPESENSE_API_KEY=change-me-typesense
TYPESENSE_PORT=8108

# networking/openldap
LDAP_ORGANISATION=gitrecon
LDAP_DOMAIN=gitrecon.local
LDAP_ADMIN_PASSWORD=change-me-ldap
LDAP_PORT=389
LDAPS_PORT=636

# networking/traefik
TRAEFIK_BIND=127.0.0.1
TRAEFIK_HTTP_PORT=80
TRAEFIK_HTTPS_PORT=443
TRAEFIK_DASHBOARD_PORT=8081

# networking/wireguard
WIREGUARD_SERVER_URL=auto
WIREGUARD_PEERS=1
WIREGUARD_SUBNET=10.13.13.0
WIREGUARD_BIND=0.0.0.0
WIREGUARD_PORT=51820

# runners/gitea-runner
GITEA_RUNNER_INSTANCE_URL=http://gitea:3000
GITEA_RUNNER_TOKEN=
GITEA_RUNNER_NAME=gitrecon

# runners/github-runner
GITHUB_RUNNER_REPOSITORY=Sarverott/gitrecon
GITHUB_RUNNER_TOKEN=
GITHUB_RUNNER_LABELS=gitrecon
GITHUB_RUNNER_PREFIX=gitrecon
GITHUB_RUNNERS=1

# runners/nats
NATS_PORT=4222
NATS_MONITOR_PORT=8222

# runners/webhook
WEBHOOK_PORT=9000
