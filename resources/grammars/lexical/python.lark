// Lexical patterns of Python: # comments; '...', "..." and triple-quoted strings with prefixes.
start: (COMMENT | STRING | NUMBER | NAME | OTHER)*

COMMENT.4: /#[^\n]*/
STRING.3: /[rRbBfFuU]{0,2}"""[\s\S]*?"""/
        | /[rRbBfFuU]{0,2}'''[\s\S]*?'''/
        | /[rRbBfFuU]{0,2}"(\\.|[^"\\\n])*"/
        | /[rRbBfFuU]{0,2}'(\\.|[^'\\\n])*'/
NUMBER.2: /0[xXoObB][0-9a-fA-F_]+|\d[\d_]*(\.\d+)?([eE][+-]?\d+)?j?/
NAME.2: /[^\W\d]\w*/
OTHER.0: /[^\s]/

%ignore /\s+/
