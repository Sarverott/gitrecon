// Lexical patterns of markup: HTML, XML, SVG, Vue/Svelte/Astro templates (comments are <!-- -->).
start: (COMMENT | STRING | NUMBER | NAME | OTHER)*

COMMENT.4: /<!--[\s\S]*?-->/
STRING.3: /"[^"]*"/
        | /'[^'\n]*'/
NUMBER.2: /\d+(\.\d+)?/
NAME.2: /[A-Za-z_][A-Za-z0-9_\-:]*/
OTHER.0: /[^\s]/

%ignore /\s+/
